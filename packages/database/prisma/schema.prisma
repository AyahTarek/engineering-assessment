generator client {
  provider = "prisma-client"
  output   = "../generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           String            @id
  name         String
  email        String            @unique
  phone        String
  applications LoanApplication[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model LoanApplication {
  id                     String                    @id
  customerId             String
  customer               Customer                 @relation(fields: [customerId], references: [id])
  status                 String
  requestedAmountCents   Int
  currency               String                    @default("EGP")
  lastEventOccurredAt    DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  history                ApplicationStatusHistory[]
  notificationJobs       NotificationJob[]

  @@index([customerId])
}

model ApplicationStatusHistory {
  id             String          @id
  applicationId  String
  application    LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status         String
  reason         String?
  sourceEventId  String
  occurredAt     DateTime
  recordedAt     DateTime        @default(now())

  @@unique([applicationId, sourceEventId])
  @@index([applicationId, occurredAt])
}

model NotificationJob {
  id              String          @id
  applicationId   String
  application     LoanApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sourceEventId   String
  type            String
  payload         String
  attemptCount    Int             @default(0)
  nextAttemptAt   DateTime?
  processedAt     DateTime?
  deadLetteredAt  DateTime?
  lastError       String?
  createdAt       DateTime        @default(now())

  // sourceEventId is non-nullable, so this is a real "one job per event"
  // invariant with no NULL loophole — it holds regardless of transaction
  // ordering or future writers (seed, replay, admin tools), not just for
  // the current recordStatusEvent path.
  @@unique([applicationId, sourceEventId])
  @@index([processedAt, deadLetteredAt, nextAttemptAt])
  @@index([sourceEventId])
}
